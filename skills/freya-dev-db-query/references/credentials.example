# Personal file: .freya/<connection>.credentials in the user home directory.
# One file per connection, that is, per tunnel. The file name without the
# suffix is the connection name: dev-db.credentials is the connection dev-db.
# Create it with scripts/init-config.mjs. Never commit the real file.
# Never put secrets in chat. Keys are explained in references/connections.md.

# Environments this tunnel reaches, comma-separated. --env looks here.
envs=REPLACE_ME
# postgres, redis, or tcp. The query script reads postgres connections only.
type=postgres

# Local end of the tunnel, and the database login.
host=127.0.0.1
port=REPLACE_WITH_YOUR_LOCAL_PORT
username=REPLACE_ME
password=REPLACE_ME

# How the user opens the tunnel. The script only prints these in the command
# it shows the user; it never runs the AWS CLI. region defaults to us-east-1.
aws_profile=REPLACE_ME
region=us-east-1
target=REPLACE_ME
remote_host=REPLACE_ME
remote_port=REPLACE_ME
